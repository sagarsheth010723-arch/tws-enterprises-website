rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDirector() {
      return request.auth != null
        && request.auth.token.email == "director@twsenterprises.in";
    }

    // This is the one fixed director profile; it is not an Auth UID document.
    match /securePanelUsers/CfcTen6kMHObMMQjcWHiwizt6Fz2 {
      allow get: if isDirector();
      allow list, create, update, delete: if false;
    }

    match /securePanelUsers/{documentId} {
      allow read, write: if false;
    }

    // Session records are limited to the authenticated director's own records.
    match /securePanelSessions/{sessionId} {
      allow create: if isDirector()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "director";
      allow get, update: if isDirector()
        && resource.data.uid == request.auth.uid;
      allow list: if isDirector();
      allow delete: if false;
    }

    // Director-managed non-sensitive Secure Panel settings.
    match /securePanelSettings/{settingId} {
      allow read, write: if isDirector();
    }

    // Bot tokens, Telegram channels, and module settings stay server-only.
    // Firebase Functions uses the Admin SDK and bypasses these client rules.
    match /securePanelTelegram/{document=**} {
      allow read, write: if false;
    }

    // Default-deny policy for every other document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
